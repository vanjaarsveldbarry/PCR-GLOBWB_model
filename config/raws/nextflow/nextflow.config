params {
    // PCR-GLOBWB_model
    model_directory = "${projectDir}/../../.."

    // INI File
    CLONE="M182"
    template_ini = "/scratch/depfg/7006713/RAWS/pcrglob_model/input/${params.CLONE}/5min_cropped.ini"
    domains_csv  = "/scratch/depfg/7006713/RAWS/sub_domains/output/clone_maps/${params.CLONE}/${params.CLONE}_domains.csv"
    outdir       = "/scratch/depfg/7006713/RAWS/pcrglob_model/output/${params.CLONE}/subbasins_${params.CLONE}"

    // PCRaster worker threads per sub-basin
    threads     = 2

    // how long a sub-basin waits on an upstream that has stopped producing before
    upstream_discharge_timeout = 600

    // Total cores the fan-out may use. The local executor will not start a task that does
    executor_cpus = 90
}

process {
    executor      = 'local'
    errorStrategy = 'terminate'

    withName: MAKE_INIS { cpus = 1 }
    withName: RUN_MODEL { cpus = params.threads as int }
}

executor {
    cpus = params.executor_cpus as int
}

// model output lands in params.outdir, so the work directory only holds the
workDir = "${projectDir}/work"

report  { enabled = true; overwrite = true; file = "${params.outdir}/_nextflow/report.html"   }
timeline{ enabled = true; overwrite = true; file = "${params.outdir}/_nextflow/timeline.html" }
trace   { enabled = true; overwrite = true; file = "${params.outdir}/_nextflow/trace.txt"     }
dag     { enabled = true; overwrite = true; file = "${params.outdir}/_nextflow/dag.html"      }
